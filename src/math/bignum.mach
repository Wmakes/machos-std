# fixed-capacity big integer
#
# a std.math.bignum.nat.Nat over LIMBS inline limbs (4096 bits), for a caller
# whose values have a known small bound. the float conversions do not use it:
# they size their own Nat storage from the format row (see std.math.ieee).

use std.types.bool.bool;
use std.types.size.usize;

use std.math.bignum.nat;

# the limb capacity of a Big
pub val LIMBS: usize = 128;

# a fixed-capacity unsigned big integer
pub rec Big {
    n: usize;
    d: [LIMBS]u32;
}

# b as a Nat over its own limbs
fun as_nat(b: *Big) nat.Nat {
    ret nat.Nat{n: b.n, d: ?b.d[0]};
}

# set b to zero
pub fun zero(b: *Big) {
    b.n = 0;
}

# drop leading-zero limbs so n is exact
pub fun norm(b: *Big) {
    var v: nat.Nat = as_nat(b);
    nat.norm(?v);
    b.n = v.n;
}

# set b to v
pub fun from_u64(b: *Big, v: u64) {
    var x: nat.Nat = as_nat(b);
    nat.from_u64(?x, v);
    b.n = x.n;
}

# set b to v
pub fun from_u128(b: *Big, v: u128) {
    var x: nat.Nat = as_nat(b);
    nat.from_u128(?x, v);
    b.n = x.n;
}

# true iff b == 0
pub fun is_zero(b: *Big) bool {
    ret b.n == 0;
}

# low 64 bits of b (exact when b < 2^64)
pub fun to_u64(b: *Big) u64 {
    var v: nat.Nat = as_nat(b);
    ret nat.to_u64(?v);
}

# dst = src
pub fun copy(dst: *Big, src: *Big) {
    var d: nat.Nat = as_nat(dst);
    var s: nat.Nat = as_nat(src);
    nat.copy(?d, ?s);
    dst.n = d.n;
}

# -1 if a < b, 0 if equal, 1 if a > b
pub fun cmp(a: *Big, b: *Big) i64 {
    var x: nat.Nat = as_nat(a);
    var y: nat.Nat = as_nat(b);
    ret nat.cmp(?x, ?y);
}

# b = b * m
pub fun mul_small(b: *Big, m: u32) {
    var v: nat.Nat = as_nat(b);
    nat.mul_small(?v, m);
    b.n = v.n;
}

# b = b << bits (multiply by 2^bits)
pub fun shl(b: *Big, bits: usize) {
    var v: nat.Nat = as_nat(b);
    nat.shl(?v, bits);
    b.n = v.n;
}

# a = a + b
pub fun add(a: *Big, b: *Big) {
    var x: nat.Nat = as_nat(a);
    var y: nat.Nat = as_nat(b);
    nat.add(?x, ?y);
    a.n = x.n;
}

# a = a - b, requires a >= b
pub fun sub(a: *Big, b: *Big) {
    var x: nat.Nat = as_nat(a);
    var y: nat.Nat = as_nat(b);
    nat.sub(?x, ?y);
    a.n = x.n;
}

# b = b + x
pub fun add_small(b: *Big, x: u32) {
    var v: nat.Nat = as_nat(b);
    nat.add_small(?v, x);
    b.n = v.n;
}

# b = b * 10^k
pub fun mul_pow10(b: *Big, k: usize) {
    var v: nat.Nat = as_nat(b);
    nat.mul_pow10(?v, k);
    b.n = v.n;
}

# number of significant bits (0 when b == 0)
pub fun bitlen(b: *Big) usize {
    var v: nat.Nat = as_nat(b);
    ret nat.bitlen(?v);
}

test bignum__from_u64_to_u64_roundtrip {
    var a: Big;
    from_u64(?a, 0);
    if (!is_zero(?a)) { ret 1; }
    from_u64(?a, 123456789);
    if (to_u64(?a) != 123456789) { ret 1; }
    from_u64(?a, 0xFFFFFFFFFF);
    if (to_u64(?a) != 0xFFFFFFFFFF) { ret 1; }
    from_u128(?a, (1::u128 << 100) | 7);
    if (bitlen(?a) != 101 || to_u64(?a) != 7) { ret 2; }
    from_u128(?a, 0);
    if (!is_zero(?a)) { ret 3; }
    ret 0;
}

test bignum__mul_small_shl_mul_pow10 {
    var a: Big;
    from_u64(?a, 123);
    mul_small(?a, 10);
    if (to_u64(?a) != 1230) { ret 1; }
    from_u64(?a, 1);
    shl(?a, 40);
    if (to_u64(?a) != 0x10000000000) { ret 1; }
    from_u64(?a, 1);
    mul_pow10(?a, 18);
    if (to_u64(?a) != 1000000000000000000) { ret 1; }
    ret 0;
}

test bignum__add_sub_cmp_bitlen {
    var a: Big;
    var b: Big;
    from_u64(?a, 0xFFFFFFFF);
    from_u64(?b, 1);
    add(?a, ?b);
    if (to_u64(?a) != 0x100000000) { ret 1; }
    if (bitlen(?a) != 33)          { ret 1; }
    sub(?a, ?b);
    if (to_u64(?a) != 0xFFFFFFFF) { ret 1; }
    from_u64(?a, 1000);
    from_u64(?b, 999);
    if (cmp(?a, ?b) != 1)  { ret 1; }
    if (cmp(?b, ?a) != -1) { ret 1; }
    if (cmp(?a, ?a) != 0)  { ret 1; }
    ret 0;
}
