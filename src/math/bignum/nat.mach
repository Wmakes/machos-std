# unsigned big integer over caller storage
#
# limbs are little-endian 32-bit; n counts active limbs (n == 0 is zero, no
# leading-zero limbs). a Nat owns nothing: its capacity is whatever storage the
# caller hands it, which must hold every value the number takes, so each user
# sizes it to its own need (std.math.ieee.bignum_limbs gives a float format's).
# all multiplies are by small constants, so no 64x64->128 is needed. the core of
# std.math.bignum.Big and of the exact float conversions in std.text.parse and
# std.format.

use std.types.bool.bool;
use std.types.size.usize;

# an unsigned big integer whose limbs live in caller storage
# ---
# n: active limbs
# d: the storage, borrowed for the number's lifetime
pub rec Nat {
    n: usize;
    d: *u32;
}

# zero over the limbs at d
# ---
# d:   storage for every value the number will take
# ret: the number, zero
pub fun over(d: *u32) Nat {
    ret Nat{n: 0, d: d};
}

# set b to zero
pub fun zero(b: *Nat) {
    b.n = 0;
}

# drop leading-zero limbs so n is exact
pub fun norm(b: *Nat) {
    for (b.n > 0 && b.d[b.n - 1] == 0) {
        b.n = b.n - 1;
    }
}

# set b to v
pub fun from_u64(b: *Nat, v: u64) {
    b.d[0] = (v & 0xFFFFFFFF)::u32;
    b.d[1] = (v >> 32)::u32;
    b.n    = 2;
    norm(b);
}

# set b to v
pub fun from_u128(b: *Nat, v: u128) {
    b.d[0] = (v & 0xFFFFFFFF)::u32;
    b.d[1] = ((v >> 32) & 0xFFFFFFFF)::u32;
    b.d[2] = ((v >> 64) & 0xFFFFFFFF)::u32;
    b.d[3] = (v >> 96)::u32;
    b.n    = 4;
    norm(b);
}

# true iff b == 0
pub fun is_zero(b: *Nat) bool {
    ret b.n == 0;
}

# low 64 bits of b (exact when b < 2^64)
pub fun to_u64(b: *Nat) u64 {
    if (b.n == 0) { ret 0; }
    if (b.n == 1) { ret b.d[0]::u64; }
    ret b.d[0]::u64 | (b.d[1]::u64 << 32);
}

# dst = src
pub fun copy(dst: *Nat, src: *Nat) {
    dst.n = src.n;
    var i: usize = 0;
    for (i < src.n) {
        dst.d[i] = src.d[i];
        i        = i + 1;
    }
}

# -1 if a < b, 0 if equal, 1 if a > b
pub fun cmp(a: *Nat, b: *Nat) i64 {
    if (a.n != b.n) {
        if (a.n < b.n) { ret -1; }
        ret 1;
    }
    var i: usize = a.n;
    for (i > 0) {
        i = i - 1;
        if (a.d[i] != b.d[i]) {
            if (a.d[i] < b.d[i]) { ret -1; }
            ret 1;
        }
    }
    ret 0;
}

# b = b * m
pub fun mul_small(b: *Nat, m: u32) {
    if (b.n == 0 || m == 0) {
        zero(b);
        ret;
    }
    var carry: u64   = 0;
    var i:     usize = 0;
    for (i < b.n) {
        val cur: u64 = b.d[i]::u64 * m::u64 + carry;
        b.d[i] = (cur & 0xFFFFFFFF)::u32;
        carry  = cur >> 32;
        i      = i + 1;
    }
    if (carry > 0) {
        b.d[b.n] = (carry & 0xFFFFFFFF)::u32;
        b.n      = b.n + 1;
    }
}

# b = b << bits (multiply by 2^bits)
pub fun shl(b: *Nat, bits: usize) {
    if (b.n == 0 || bits == 0) { ret; }
    val limb_shift: usize = bits / 32;
    val bit_shift:  usize = bits % 32;
    if (bit_shift > 0) {
        var carry: u64   = 0;
        var i:     usize = 0;
        for (i < b.n) {
            val v: u64 = (b.d[i]::u64 << bit_shift) | carry;
            b.d[i] = (v & 0xFFFFFFFF)::u32;
            carry  = v >> 32;
            i      = i + 1;
        }
        if (carry > 0) {
            b.d[b.n] = (carry & 0xFFFFFFFF)::u32;
            b.n      = b.n + 1;
        }
    }
    if (limb_shift > 0) {
        var i: usize = b.n;
        for (i > 0) {
            i                   = i - 1;
            b.d[i + limb_shift] = b.d[i];
        }
        var j: usize = 0;
        for (j < limb_shift) {
            b.d[j] = 0;
            j      = j + 1;
        }
        b.n = b.n + limb_shift;
    }
}

# a = a + b
pub fun add(a: *Nat, b: *Nat) {
    var maxn: usize = a.n;
    if (b.n > maxn) { maxn = b.n; }
    var carry: u64   = 0;
    var i:     usize = 0;
    for (i < maxn) {
        var av: u64 = 0;
        if (i < a.n) { av = a.d[i]::u64; }
        var bv: u64 = 0;
        if (i < b.n) { bv = b.d[i]::u64; }
        val s: u64 = av + bv + carry;
        a.d[i] = (s & 0xFFFFFFFF)::u32;
        carry  = s >> 32;
        i      = i + 1;
    }
    a.n = maxn;
    if (carry > 0) {
        a.d[a.n] = (carry & 0xFFFFFFFF)::u32;
        a.n      = a.n + 1;
    }
    norm(a);
}

# a = a - b, requires a >= b
pub fun sub(a: *Nat, b: *Nat) {
    var borrow: i64   = 0;
    var i:      usize = 0;
    for (i < a.n) {
        var bv: i64 = 0;
        if (i < b.n) { bv = b.d[i]::i64; }
        var t: i64 = a.d[i]::i64 - bv - borrow;
        if (t < 0) {
            t      = t + 0x100000000;
            borrow = 1;
        }
        or {
            borrow = 0;
        }
        a.d[i] = t::u32;
        i      = i + 1;
    }
    norm(a);
}

# b = b + x
pub fun add_small(b: *Nat, x: u32) {
    if (b.n == 0) {
        from_u64(b, x::u64);
        ret;
    }
    var carry: u64   = x::u64;
    var i:     usize = 0;
    for (carry > 0 && i < b.n) {
        val s: u64 = b.d[i]::u64 + carry;
        b.d[i] = (s & 0xFFFFFFFF)::u32;
        carry  = s >> 32;
        i      = i + 1;
    }
    if (carry > 0) {
        b.d[b.n] = (carry & 0xFFFFFFFF)::u32;
        b.n      = b.n + 1;
    }
}

# b = b * 10^k
pub fun mul_pow10(b: *Nat, k: usize) {
    var rem: usize = k;
    for (rem >= 9) {
        mul_small(b, 1000000000);
        rem = rem - 9;
    }
    var p: u32   = 1;
    var i: usize = 0;
    for (i < rem) {
        p = p * 10;
        i = i + 1;
    }
    if (p > 1) {
        mul_small(b, p);
    }
}

# number of significant bits (0 when b == 0)
pub fun bitlen(b: *Nat) usize {
    if (b.n == 0) { ret 0; }
    var top:  u32   = b.d[b.n - 1];
    var bits: usize = 0;
    for (top > 0) {
        bits = bits + 1;
        top  = top >> 1;
    }
    ret (b.n - 1) * 32 + bits;
}

# a nat reaches as far as its storage, past any fixed capacity, and leaves the
# storage beyond its need untouched
test nat__holds_what_its_storage_holds {
    var s: [202]u32;
    s[201] = 0xA5A5A5A5;
    var a: Nat = over(?s[0]);
    # 10^1900 has floor(1900 * log2(10)) + 1 = 6312 bits, 198 limbs
    from_u64(?a, 1);
    mul_pow10(?a, 1900);
    if (bitlen(?a) != 6312 || a.n != 198) { ret 1; }
    shl(?a, 100);
    if (bitlen(?a) != 6412 || a.n != 201) { ret 2; }
    if (s[201] != 0xA5A5A5A5)             { ret 3; }
    var b: Nat = over(?s[0]);
    from_u64(?b, 7);
    if (to_u64(?b) != 7) { ret 4; }
    ret 0;
}
