# MachOS program entrypoint (x86_64)
# ---
# provides `_start`, the ELF entry point for MachOS executables. MachOS enters
# it with argc in rdi, argv in rsi and envp in rdx, on a 16-aligned stack.
#
# this entrypoint:
#   1. keeps argc, argv and envp
#   2. calls _rt_init to store envp into the OS layer
#   3. calls user-supplied `main(argc, argv)`
#   4. exits with the code main returned
#
# user code must define:
#   #[symbol("main")]
#   fun main(argc: i64, argv: **u8) i64 { ... }

use os: std.system.os.machos;
use os_shared: std.system.os.shared;
use std.system.panic.panic;

$if (!($mach.build.os == $mach.os.freestanding && $mach.build.platform == "machos")) {
    $error("std.runtime.machos needs the machos platform");
}

#[symbol("_rt_argc")]
var _rt_argc: i64 = 0;
#[symbol("_rt_argv")]
var _rt_argv: u64 = 0;
#[symbol("_rt_envp")]
var _rt_envp: u64 = 0;

# the main thread's block (its FS base); spawned threads get theirs from
# the OS layer
var main_block: os_shared.ThreadBlock;

#[symbol("_rt_init")]
fun _rt_init() {
    os._envp = _rt_envp;
    if (os.thread_block_enter(?main_block) < 0) {
        panic("std.runtime: the main thread's block could not be installed\n");
    }
}

#[symbol("_start")]
pub fun _start() {
    asm x86_64 {
        mov [_rt_argc], rdi
        mov [_rt_argv], rsi
        mov [_rt_envp], rdx

        and rsp, -16      # 16-align rsp for the SysV call boundary
        call _rt_init

        mov rdi, [_rt_argc]
        mov rsi, [_rt_argv]
        call main

        mov rdi, rax      # exit code from main
        mov rax, 0        # MachOS EXIT
        syscall
    }
}
