# sockets: IPv4 datagrams (UDP, and ICMP echo for ping) so far; streams
# (TCP) return ENOSYS until the kernel has them. the constants are linux's,
# and so is the sockaddr_in layout MachOS takes

pub val AF_INET:             i32 = 2;
pub val AF_INET6:            i32 = 10;
pub val SOCK_STREAM:         i32 = 1;
pub val SOCK_DGRAM:          i32 = 2;
pub val SOCK_NONBLOCK:       i32 = O_NONBLOCK;
pub val SOCK_CLOEXEC:        i32 = O_CLOEXEC;
pub val SOL_SOCKET:          i32 = 1;
pub val SO_UNSUPPORTED:      i32 = -2147483648;
pub val SO_REUSEADDR:        i32 = 2;
pub val SO_REUSEPORT:        i32 = 15;
pub val SO_EXCLUSIVEADDRUSE: i32 = SO_UNSUPPORTED;
pub val SO_KEEPALIVE:        i32 = 9;
pub val SO_SNDBUF:           i32 = 7;
pub val SO_RCVBUF:           i32 = 8;
pub val SO_LINGER:           i32 = 13;
pub val SO_RCVTIMEO:         i32 = 20;
pub val SO_BROADCAST:        i32 = 6;
pub val IPPROTO_IP:          i32 = 0;
pub val IPPROTO_TCP:         i32 = 6;
pub val IPPROTO_IPV6:        i32 = 41;
pub val IP_TOS:              i32 = 1;
pub val IPV6_V6ONLY:         i32 = 26;
pub val IPV6_TCLASS:         i32 = 67;
pub val TCP_NODELAY:         i32 = 1;
pub val TCP_KEEPIDLE:        i32 = 4;
pub val TCP_KEEPINTVL:       i32 = 5;
pub val TCP_KEEPCNT:         i32 = 6;
pub val TCP_FASTOPEN:        i32 = 23;
pub val SHUT_RD:             i32 = 0;
pub val SHUT_WR:             i32 = 1;
pub val SHUT_RDWR:           i32 = 2;

pub val SOCKADDR_IN_SIZE:      usize = 16;
pub val SOCKADDR_IN6_SIZE:     usize = 28;
pub val SOCKADDR_STORAGE_SIZE: usize = 128;

pub rec IoVector {
    data:   *u8;
    length: usize;
}

pub val MSG_CTRUNC:             i32   = 0x8;
pub val MSG_CMSG_CLOEXEC:       i32   = 0x40000000;
pub val SCM_RIGHTS:             i32   = 1;
pub val SCM_CREDENTIALS:        i32   = 2;
pub val SCM_PIDFD:              i32   = 4;
pub val SCM_MAX_FD:             usize = 253;
pub val LOCAL_CONTROL_CAPACITY: usize = 1088;

pub fun sock_send(fd: usize, buf: *u8, len: usize) i64 { ret syscall5(SYS_SENDTO, fd, buf::usize, len, 0, 0); }
pub fun sock_recv(fd: usize, buf: *u8, len: usize) i64 { ret syscall5(SYS_RECVFROM, fd, buf::usize, len, 0, 0); }
pub fun sock_peek_readable(fd: usize) i64 { ret ENOSYS; }
pub fun sock_write_vector(fd: usize, vectors: *IoVector, count: usize) i64 {
    var total: i64 = 0;
    var i: usize = 0;
    for (i < count) {
        val v: *IoVector = (vectors::usize + i * $size_of(IoVector)::usize)::*IoVector;
        val r: i64 = sock_send(fd, v.data, v.length);
        if (r < 0) {
            if (total > 0) { ret total; }
            ret r;
        }
        total = total + r;
        i = i + 1;
    }
    ret total;
}
pub fun sock_send_message(fd: usize, vectors: *IoVector, vector_count: usize, address: *u8, address_length: u32, control: *u8, control_length: usize) i64 { ret ENOSYS; }
pub fun sock_receive_message(fd: usize, vectors: *IoVector, vector_count: usize, address: *u8, address_length: *u32, control: *u8, control_length: *usize, flags: *i32) i64 { ret ENOSYS; }
pub fun sock_recv_close_rights(fd: usize, buffer: *u8, length: usize, address: *u8, address_length: *u32, control: *u8, capacity: usize) i64 { ret ENOSYS; }
pub fun local_stream_recv(fd: usize, buffer: *u8, length: usize) i64 { ret ENOSYS; }
pub fun sock_connect_status(fd: usize) i64 { ret 0; }
pub fun sock_close(fd: usize) i64 { ret close(fd::isize::i32); }

pub fun sock_create(domain: i32, typ: i32, protocol: i32, out: *usize) i64 {
    ret sock_create_flags(domain, typ, protocol, false, false, out);
}

pub fun sock_create_flags(domain: i32, typ: i32, protocol: i32, nonblocking: bool, non_inheritable: bool, out: *usize) i64 {
    if (out == nil) { ret EINVAL; }
    @out = (-1)::isize::usize;
    val raw: i64 = syscall3(SYS_SOCKET, domain::u32::usize, typ::u32::usize, protocol::u32::usize);
    if (raw < 0) { ret raw; }
    @out = raw::usize;
    ret 0;
}

pub fun sock_bind(fd: usize, addr: *u8, addrlen: usize) i64 { ret syscall3(SYS_BIND, fd, addr::usize, addrlen); }
pub fun sock_listen(fd: usize, backlog: i32) i64 { ret ENOSYS; }
pub fun sock_accept(fd: usize, addr: *u8, addrlen: *u32, out: *usize) i64 { ret ENOSYS; }
pub fun sock_accept_flags(fd: usize, addr: *u8, addrlen: *u32, nonblocking: bool, non_inheritable: bool, out: *usize) i64 { ret ENOSYS; }
pub fun sock_connect(fd: usize, addr: *u8, addrlen: usize) i64 { ret syscall3(SYS_CONNECT, fd, addr::usize, addrlen); }

pub fun sock_sendto(fd: usize, buf: *u8, len: usize, flags: i32, addr: *u8, addrlen: usize) i64 {
    ret syscall5(SYS_SENDTO, fd, buf::usize, len, addr::usize, addrlen);
}

pub fun sock_recvfrom(fd: usize, buf: *u8, len: usize, flags: i32, addr: *u8, addrlen: *u32) i64 {
    ret syscall5(SYS_RECVFROM, fd, buf::usize, len, addr::usize, addrlen::usize);
}

pub fun sock_shutdown(fd: usize, how: i32) i64 { ret ENOSYS; }

# SO_RCVTIMEO (a struct timeval) and SO_BROADCAST (an int); the others are
# not settable on MachOS
pub fun sock_setopt(fd: usize, level: i32, opt: i32, value: *u8, vallen: usize) i64 {
    if (level != SOL_SOCKET || value == nil) { ret ENOTSUP; }
    if (opt == SO_RCVTIMEO && vallen >= 16) {
        val sec: i64 = @(value::*i64);
        val usec: i64 = @((value::usize + 8)::*i64);
        ret syscall3(SYS_SETSOCKOPT, fd, MACHOS_SO_RCVTIMEO, (sec * 1000 + usec / 1000)::usize);
    }
    if (opt == SO_BROADCAST && vallen >= 4) {
        ret syscall3(SYS_SETSOCKOPT, fd, MACHOS_SO_BROADCAST, (@(value::*i32))::u32::usize);
    }
    ret ENOTSUP;
}

pub fun sock_getopt(fd: usize, level: i32, opt: i32, value: *u8, vallen: *u32) i64 { ret ENOTSUP; }

pub fun sock_local_addr(fd: usize, addr: *u8, addrlen: *u32) i64 {
    val r: i64 = syscall2(SYS_GETSOCKNAME, fd, addr::usize);
    if (r >= 0 && addrlen != nil) { @addrlen = 16; }
    ret r;
}

pub fun sock_remote_addr(fd: usize, addr: *u8, addrlen: *u32) i64 { ret ENOTSUP; }

# no socket handle is passed on across exec here
pub fun sock_inheritable(fd: usize, out: *bool) i64 {
    @out = false;
    ret 0;
}

pub fun sock_set_rcvtimeo(fd: usize, ms: u64) i64 { ret syscall3(SYS_SETSOCKOPT, fd, MACHOS_SO_RCVTIMEO, ms::usize); }

# dns
pub val DNS_HOSTS_PATH: str = "/etc/hosts";

# errors

pub fun error_kind(code: i64) io_error.Kind {
    if (code == EINTR)                                                    { ret io_error.INTERRUPTED; }
    or (code == EAGAIN)                                                   { ret io_error.WOULD_BLOCK; }
    or (code == ETIMEDOUT)                                                { ret io_error.TIMEOUT; }
    or (code == ECANCELED)                                                { ret io_error.CANCELLED; }
    or (code == ECONNREFUSED)                                             { ret io_error.REFUSED; }
    or (code == ECONNRESET)                                               { ret io_error.RESET; }
    or (code == ECONNABORTED)                                             { ret io_error.ABORTED; }
    or (code == EBADF || code == EPIPE || code == ENOTCONN)               { ret io_error.CLOSED; }
    or (code == EADDRINUSE)                                               { ret io_error.ADDRESS_IN_USE; }
    or (code == ENETUNREACH || code == EHOSTUNREACH)                      { ret io_error.UNREACHABLE; }
    or (code == EACCES || code == EPERM)                                  { ret io_error.PERMISSION; }
    or (code == ENOMEM || code == ENFILE || code == EMFILE || code == ENOSPC) { ret io_error.RESOURCE_EXHAUSTED; }
    or (code == EINVAL)                                                   { ret io_error.INVALID; }
    or (code == ENOTSUP || code == ENOSYS)                                { ret io_error.UNSUPPORTED; }
    or (code == ENOENT)                                                   { ret io_error.NOT_FOUND; }
    or (code == EEXIST)                                                   { ret io_error.EXISTS; }
    or (code == ENOTDIR)                                                  { ret io_error.NOT_DIRECTORY; }
    or (code == EISDIR)                                                   { ret io_error.IS_DIRECTORY; }
    or (code == ENOTEMPTY)                                                { ret io_error.NOT_EMPTY; }
    or (code == ENAMETOOLONG)                                             { ret io_error.NAME_TOO_LONG; }
    or (code == EBUSY)                                                    { ret io_error.BUSY; }
    or (code == EIO)                                                      { ret io_error.IO; }
    or (code == ERANGE)                                                   { ret io_error.RANGE; }
    or (code == ECHILD)                                                   { ret io_error.NO_CHILD; }
    or (code == ELOOP)                                                    { ret io_error.LOOP; }
    ret io_error.OTHER;
}

# MachOS's own words for its errors (sdk/src/abi.mach's err_name)
pub fun error_message(code: i64) str {
    if (code == ENOENT)       { ret "no such file or directory"; }
    or (code == EEXIST)       { ret "already exists"; }
    or (code == ENOTDIR)      { ret "not a directory"; }
    or (code == EISDIR)       { ret "is a directory"; }
    or (code == EBADF)        { ret "bad handle"; }
    or (code == EFAULT)       { ret "bad address"; }
    or (code == ENOMEM)       { ret "out of memory"; }
    or (code == EINVAL)       { ret "invalid argument"; }
    or (code == ENOEXEC)      { ret "not an executable"; }
    or (code == ECHILD)       { ret "no such child"; }
    or (code == ENOTEMPTY)    { ret "directory not empty"; }
    or (code == EPIPE)        { ret "broken pipe"; }
    or (code == ENOSYS)       { ret "no such system call"; }
    or (code == EMFILE)       { ret "too many open handles"; }
    or (code == EAGAIN)       { ret "too many processes"; }
    or (code == ESRCH)        { ret "no such process"; }
    or (code == ENAMETOOLONG) { ret "name too long"; }
    or (code == ENOSPC)       { ret "no space left on device"; }
    or (code == EIO)          { ret "input/output error"; }
    or (code == EXDEV)        { ret "cannot move across filesystems"; }
    or (code == EBUSY)        { ret "busy"; }
    or (code == ENOTTY)       { ret "not a terminal"; }
    or (code == EINTR)        { ret "interrupted"; }
    or (code == EPERM)        { ret "operation not permitted"; }
    or (code == EACCES)       { ret "permission denied"; }
    or (code == ENOTSUP)      { ret "not supported"; }
    or (code == EROFS)        { ret "read-only filesystem"; }
    or (code == ELOOP)        { ret "too many symbolic links"; }
    or (code == ERANGE)       { ret "result out of range"; }
    or (code == ETIMEDOUT)    { ret "timed out"; }
    or (code == ENXIO)        { ret "no such device or address"; }
    or (code == ENODEV)       { ret "no such device"; }
    or (code == E2BIG)        { ret "argument list too long"; }
    or (code == ENFILE)       { ret "too many open files in the system"; }
    or (code == ESPIPE)       { ret "cannot seek"; }
    or (code == ETXTBSY)      { ret "text file busy"; }
    or (code == EADDRINUSE)   { ret "address in use"; }
    or (code == ENETUNREACH)  { ret "network unreachable"; }
    or (code == ECONNABORTED) { ret "connection aborted"; }
    or (code == ECONNRESET)   { ret "connection reset"; }
    or (code == ENOTCONN)     { ret "not connected"; }
    or (code == ECONNREFUSED) { ret "connection refused"; }
    or (code == EHOSTUNREACH) { ret "host unreachable"; }
    or (code == ECANCELED)    { ret "cancelled"; }
    ret "unknown error";
}
