# the MachOS OS layer (https://github.com/Wmakes/MachOS)
#
# MachOS is a freestanding target with `platform = "machos"` in its manifest;
# std.system.capability.MACHOS selects this module. a call is `syscall` with
# the number in rax and up to five arguments in rdi, rsi, rdx, r10 and r8; a
# result at or above 2^64 - 4096 is an error, the MachOS error number negated.
# those negated numbers are this module's native codes. the numbers below
# follow MachOS's sdk/src/abi.mach, which only ever adds to them.
#
# MachOS paths are (pointer, length) pairs relative to the working directory.
# a path relative to a directory handle is joined onto the handle's own path
# (FDPATH) first. groups the kernel does not provide yet (threads, the io
# queue, sockets) return ENOSYS, and std.system.capability does not claim them.

use io_error:      std.io.error;
use cpu_features_: std.system.cpu.features;
use identities:    std.system.file_identity;
use os_shared:     std.system.os.shared;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.isize;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_starts_with;

$if (!($mach.build.os == $mach.os.freestanding && $mach.build.platform == "machos")) {
    $error("std.system.os.machos: requires a freestanding target with platform \"machos\"");
}
$if ($mach.build.arch != $mach.arch.x86_64) {
    $error("std.system.os.machos: MachOS runs on x86_64 only");
}

# system calls
val SYS_EXIT:      usize = 0;
val SYS_READ:      usize = 1;
val SYS_WRITE:     usize = 2;
val SYS_OPEN:      usize = 3;
val SYS_CLOSE:     usize = 4;
val SYS_SPAWN:     usize = 5;
val SYS_WAIT:      usize = 6;
val SYS_READDIR:   usize = 7;
val SYS_STAT:      usize = 8;
val SYS_MKDIR:     usize = 9;
val SYS_REMOVE:    usize = 10;
val SYS_CHDIR:     usize = 11;
val SYS_GETCWD:    usize = 12;
val SYS_PIPE:      usize = 13;
val SYS_SLEEP:     usize = 14;
val SYS_INFO:      usize = 15;
val SYS_GETPID:    usize = 16;
val SYS_KILL:      usize = 18;
val SYS_SBRK:      usize = 19;
val SYS_RENAME:    usize = 21;
val SYS_SEEK:      usize = 22;
val SYS_SYNC:      usize = 23;
val SYS_FSTAT:     usize = 35;
val SYS_SIGACTION: usize = 39;
val SYS_CHMOD:     usize = 49;
val SYS_ACCESS:    usize = 58;
val SYS_MMAP:      usize = 59;
val SYS_MUNMAP:    usize = 60;
val SYS_MPROTECT:  usize = 61;
val SYS_CLOCK:     usize = 63;
val SYS_GETRANDOM: usize = 64;
val SYS_PREAD:     usize = 65;
val SYS_PWRITE:    usize = 66;
val SYS_FDPATH:    usize = 67;
val SYS_SOCKET:    usize = 68;
val SYS_BIND:      usize = 69;
val SYS_CONNECT:   usize = 70;
val SYS_SENDTO:    usize = 71;
val SYS_RECVFROM:  usize = 72;
val SYS_SETSOCKOPT: usize = 73;
val SYS_GETSOCKNAME: usize = 74;

# MachOS's own socket options (SETSOCKOPT takes the value itself)
val MACHOS_SO_RCVTIMEO:  usize = 1;
val MACHOS_SO_BROADCAST: usize = 2;

val MAP_PRIVATE:   usize = 0x02;
val MAP_ANONYMOUS: usize = 0x20;

val KIND_FILE: u64 = 1;
val KIND_DIR:  u64 = 2;
val KIND_DEV:  u64 = 3;
val KIND_PIPE: u64 = 4;

val SIGKILL: usize = 9;
val SIGPIPE: usize = 13;
val SIG_IGN: usize = 1;

val PATH_MAX: usize = 256;

# kernel ABI types

# what FSTAT and STAT fill in
rec NativeStat {
    kind:   u64;
    size:   u64;
    mtime:  u64;
    mode:   u64;
    uid:    u64;
    gid:    u64;
    sector: u64;
    rdev:   u64;
    dev:    u64;
    ino:    u64;
    nlink:  u64;
}

# one READDIR entry
rec NativeEntry {
    kind:     u64;
    size:     u64;
    mtime:    u64;
    mode:     u64;
    uid:      u64;
    gid:      u64;
    name_len: u64;
    name:     [60]u8;
}

# how SPAWN starts a child
rec NativeSpawn {
    handles: [10]u64;
    group:   u64;
    map_fds: u64;
    env:     *u8;
    env_len: u64;
}

val FD_NONE: u64 = 0xFFFFFFFFFFFFFFFF;

# a POSIX-shaped stat, filled from MachOS's own
pub rec stat_t {
    st_dev:        u64;
    st_ino:        u64;
    st_nlink:      u64;
    st_mode:       u32;
    st_uid:        u32;
    st_gid:        u32;
    pad0:          i32;
    st_rdev:       u64;
    st_size:       i64;
    st_blksize:    i64;
    st_blocks:     i64;
    st_atime:      i64;
    st_atime_nsec: i64;
    st_mtime:      i64;
    st_mtime_nsec: i64;
    st_ctime:      i64;
    st_ctime_nsec: i64;
}

pub rec timespec {
    tv_sec:  i64;
    tv_nsec: i64;
}

# a directory being read: READDIR takes an index, the entry lives here
pub rec DirectoryCursor {
    address: usize;
    fd:      i32;
    active:  bool;
    ended:   bool;
    error:   i64;
    index:   u64;
    entry:   NativeEntry;
    name:    [61]u8;
}

fwd DirectoryEntry:      os_shared.DirectoryEntry;
fwd DirectoryInitResult: os_shared.DirectoryInitResult;

# path
pub val separator: u8 = '/';

# constants
pub val STDIN_FD:  i32 = 0;
pub val STDOUT_FD: i32 = 1;
pub val STDERR_FD: i32 = 2;

# MachOS's own OPEN flags
pub val O_RDONLY:    i32 = 1;
pub val O_WRONLY:    i32 = 2;
pub val O_RDWR:      i32 = 3;
pub val O_CREAT:     i32 = 4;
pub val O_TRUNC:     i32 = 8;
pub val O_APPEND:    i32 = 16;
pub val O_CLOEXEC:   i32 = 32;
pub val O_EXCL:      i32 = 64;
pub val O_DIRECTORY: i32 = 128;
pub val O_NOFOLLOW:  i32 = 256;
pub val O_NONBLOCK:  i32 = 512; # accepted, not yet honoured

pub val AT_FDCWD:            i32 = -100;
pub val AT_SYMLINK_NOFOLLOW: i32 = 0x0100;
pub val AT_REMOVEDIR:        i32 = 0x0200;

pub val LOCK_SH: i32 = 1;
pub val LOCK_EX: i32 = 2;
pub val LOCK_NB: i32 = 4;
pub val LOCK_UN: i32 = 8;

pub val S_IFMT:  u32 = 0o170000;
pub val S_IFDIR: u32 = 0o040000;
pub val S_IFREG: u32 = 0o100000;
pub val S_IFLNK: u32 = 0o120000;
pub val S_IFCHR: u32 = 0o020000;
pub val S_IFIFO: u32 = 0o010000;

pub val WNOHANG:    i32 = 1;
pub val WUNTRACED:  i32 = 2;
pub val WCONTINUED: i32 = 8;

pub val CLOCK_REALTIME:  i32 = 0;
pub val CLOCK_MONOTONIC: i32 = 1;

# MachOS error numbers, negated
pub val ENOENT:       i64 = -1;
pub val EEXIST:       i64 = -2;
pub val ENOTDIR:      i64 = -3;
pub val EISDIR:       i64 = -4;
pub val EBADF:        i64 = -5;
pub val EFAULT:       i64 = -6;
pub val ENOMEM:       i64 = -7;
pub val EINVAL:       i64 = -8;
pub val ENOEXEC:      i64 = -9;
pub val ECHILD:       i64 = -10;
pub val ENOTEMPTY:    i64 = -11;
pub val EPIPE:        i64 = -12;
pub val ENOSYS:       i64 = -13;
pub val EMFILE:       i64 = -14;
pub val EAGAIN:       i64 = -15;
pub val ESRCH:        i64 = -16;
pub val ENAMETOOLONG: i64 = -17;
pub val ENOSPC:       i64 = -18;
pub val EIO:          i64 = -19;
pub val EXDEV:        i64 = -20;
pub val EBUSY:        i64 = -21;
pub val ENOTTY:       i64 = -22;
pub val EINTR:        i64 = -23;
pub val EPERM:        i64 = -24;
pub val EACCES:       i64 = -25;
pub val ENOTSUP:      i64 = -26;
pub val EROFS:        i64 = -27;
pub val ELOOP:        i64 = -28;
pub val ERANGE:       i64 = -29;
pub val ETIMEDOUT:    i64 = -30;
pub val ENXIO:        i64 = -31;
pub val ENODEV:       i64 = -32;
pub val E2BIG:        i64 = -33;
pub val ENFILE:       i64 = -34;
pub val ESPIPE:       i64 = -35;
pub val ETXTBSY:      i64 = -36;
pub val EADDRINUSE:   i64 = -37;
pub val ENETUNREACH:  i64 = -38;
pub val ECONNABORTED: i64 = -39;
pub val ECONNRESET:   i64 = -40;
pub val ENOTCONN:     i64 = -41;
pub val ECONNREFUSED: i64 = -42;
pub val EHOSTUNREACH: i64 = -43;
pub val ECANCELED:    i64 = -44;

pub val EINTR_MAX_RETRIES: usize = 8;

# feature detection
pub fun has_numa() bool { ret false; }
pub fun has_huge_pages() bool { ret false; }

# syscall wrappers

pub fun syscall0(n: usize) i64 {
    var out: i64;
    asm x86_64 {
        mov rax, {n}
        syscall
        mov {out}, rax
    }
    ret out;
}

pub fun syscall1(n: usize, a0: usize) i64 {
    var out: i64;
    asm x86_64 {
        mov rax, {n}
        mov rdi, {a0}
        syscall
        mov {out}, rax
    }
    ret out;
}

pub fun syscall2(n: usize, a0: usize, a1: usize) i64 {
    var out: i64;
    asm x86_64 {
        mov rax, {n}
        mov rdi, {a0}
        mov rsi, {a1}
        syscall
        mov {out}, rax
    }
    ret out;
}

pub fun syscall3(n: usize, a0: usize, a1: usize, a2: usize) i64 {
    var out: i64;
    asm x86_64 {
        mov rax, {n}
        mov rdi, {a0}
        mov rsi, {a1}
        mov rdx, {a2}
        syscall
        mov {out}, rax
    }
    ret out;
}

pub fun syscall4(n: usize, a0: usize, a1: usize, a2: usize, a3: usize) i64 {
    var out: i64;
    asm x86_64 {
        mov rax, {n}
        mov rdi, {a0}
        mov rsi, {a1}
        mov rdx, {a2}
        mov r10, {a3}
        syscall
        mov {out}, rax
    }
    ret out;
}

pub fun syscall5(n: usize, a0: usize, a1: usize, a2: usize, a3: usize, a4: usize) i64 {
    var out: i64;
    asm x86_64 {
        mov rax, {n}
        mov rdi, {a0}
        mov rsi, {a1}
        mov rdx, {a2}
        mov r10, {a3}
        mov r8, {a4}
        syscall
        mov {out}, rax
    }
    ret out;
}

# MachOS takes five arguments at most
pub fun syscall6(n: usize, a0: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize) i64 {
    if (a5 != 0) { ret EINVAL; }
    ret syscall5(n, a0, a1, a2, a3, a4);
}

# paths

# `path` relative to directory handle `dirfd` (AT_FDCWD: the working
# directory) as a path MachOS resolves on its own
# ---
# out: PATH_MAX bytes, NUL-terminated on success
# ret: the path's length, or a negative native code
fun resolve(dirfd: i32, path: *u8, out: *u8) i64 {
    if (path == nil) { ret EFAULT; }
    val n: usize = str_len(path);
    if (n == 0) { ret ENOENT; }
    var at: usize = 0;
    if (path[0] != '/' && dirfd != AT_FDCWD) {
        val got: i64 = syscall3(SYS_FDPATH, dirfd::isize::usize, out::usize, PATH_MAX);
        if (got < 0) { ret got; }
        at = got::usize;
        if (at >= PATH_MAX) { ret ENAMETOOLONG; }
        if (at == 0 || out[at - 1] != '/') {
            out[at] = '/';
            at      = at + 1;
        }
    }
    if (at + n >= PATH_MAX) { ret ENAMETOOLONG; }
    var i: usize = 0;
    for (i < n) {
        out[at + i] = path[i];
        i           = i + 1;
    }
    out[at + n] = 0;
    ret (at + n)::i64;
}

# memory

pub fun page_size() usize {
    ret 4096;
}

pub fun allocate(size: usize) ptr {
    if (size == 0) { ret nil; }
    val res: i64 = syscall5(SYS_MMAP, 0, size, 3 | ((MAP_PRIVATE | MAP_ANONYMOUS) << 8), 0, 0);
    if (res < 0) { ret nil; }
    ret res::usize::ptr;
}

pub fun deallocate(p: ptr, size: usize) i64 {
    if (p == nil || size == 0) { ret 0; }
    ret syscall2(SYS_MUNMAP, p::usize, size);
}

# MachOS has no mremap: a new mapping, the bytes copied over, the old one gone
pub fun reallocate(p: ptr, old_size: usize, new_size: usize) ptr {
    if (p == nil) { ret allocate(new_size); }
    if (new_size == 0) {
        deallocate(p, old_size);
        ret nil;
    }
    val fresh: ptr = allocate(new_size);
    if (fresh == nil) { ret nil; }
    var n: usize = old_size;
    if (new_size < n) { n = new_size; }
    val src: *u8 = p::*u8;
    val dst: *u8 = fresh::*u8;
    var i:   usize = 0;
    for (i < n) {
        dst[i] = src[i];
        i      = i + 1;
    }
    deallocate(p, old_size);
    ret fresh;
}

# the program break, as brk(0) gives it
pub fun heap_region_base() usize {
    ret syscall1(SYS_SBRK, 0)::usize;
}

# move the break to addr; the break afterwards (the old one on failure)
pub fun heap_region_extend(addr: usize) usize {
    val now: usize = syscall1(SYS_SBRK, 0)::usize;
    if (addr <= now) { ret now; }
    val res: i64 = syscall1(SYS_SBRK, addr - now);
    if (res < 0) { ret now; }
    ret addr;
}

pub fun protect(p: ptr, size: usize, prot: u32) i64 {
    ret syscall3(SYS_MPROTECT, p::usize, size, prot::usize);
}

pub fun lock(p: ptr, size: usize) i64 { ret ENOTSUP; }
pub fun unlock(p: ptr, size: usize) i64 { ret ENOTSUP; }
pub fun advise(p: ptr, size: usize, advice: u32) i64 { ret ENOTSUP; }

pub fun allocate_huge(size: usize, page_size: usize) ptr { ret nil; }
pub fun numa_node_count() usize { ret 1; }
pub fun numa_current_node() usize { ret 0; }
pub fun numa_allocate(size: usize, node: usize) ptr { ret allocate(size); }
pub fun numa_move(p: ptr, size: usize, node: usize) i64 { ret ENOTSUP; }

# a private copy of a file's pages
pub fun map_file(fd: i32, offset: usize, size: usize, prot: u32) ptr {
    val res: i64 = syscall5(SYS_MMAP, 0, size, prot::usize | (MAP_PRIVATE << 8), fd::isize::usize, offset);
    if (res < 0) { ret nil; }
    ret res::usize::ptr;
}

# file mappings are private copies: there is nothing to write back
pub fun sync_file(p: ptr, size: usize) i64 {
    ret 0;
}

# files

pub fun read(fd: i32, buf: *u8, count: usize) i64 {
    var retries: usize = 0;
    for {
        val r: i64 = syscall3(SYS_READ, fd::isize::usize, buf::usize, count);
        if (r != EINTR || retries >= EINTR_MAX_RETRIES) { ret r; }
        retries = retries + 1;
    }
    ret EINTR;
}

pub fun write(fd: i32, buf: *u8, count: usize) i64 {
    ret syscall3(SYS_WRITE, fd::isize::usize, buf::usize, count);
}

pub fun read_at(fd: i32, buf: *u8, count: usize, offset: u64) i64 {
    ret syscall4(SYS_PREAD, fd::isize::usize, buf::usize, count, offset);
}

pub fun write_at(fd: i32, buf: *u8, count: usize, offset: u64) i64 {
    ret syscall4(SYS_PWRITE, fd::isize::usize, buf::usize, count, offset);
}

pub fun open(dirfd: i32, path: *u8, flags: i32, mode: i32) i64 {
    var full:   [256]u8;
    val n:      i64 = resolve(dirfd, path, ?full[0]);
    if (n < 0) { ret n; }
    var native: i32 = flags;
    if ((native & O_RDWR) == 0) { native = native | O_RDONLY; }
    ret syscall4(SYS_OPEN, (?full[0])::usize, n::usize, native::u32::usize, mode::u32::usize);
}

pub fun close(fd: i32) i64 {
    ret syscall1(SYS_CLOSE, fd::isize::usize);
}

# MachOS writes everything pending at once
pub fun sync_fd(fd: i32) i64 {
    ret syscall0(SYS_SYNC);
}

fun fill_stat(native: *NativeStat, st: *stat_t) {
    var kind: u32 = S_IFREG;
    if (native.kind == KIND_DIR) { kind = S_IFDIR; }
    or (native.kind == KIND_DEV) { kind = S_IFCHR; }
    or (native.kind == KIND_PIPE) { kind = S_IFIFO; }
    st.st_dev        = native.dev;
    st.st_ino        = native.ino;
    st.st_nlink      = native.nlink;
    st.st_mode       = kind | (native.mode & 0o7777)::u32;
    st.st_uid        = native.uid::u32;
    st.st_gid        = native.gid::u32;
    st.pad0          = 0;
    st.st_rdev       = native.rdev;
    st.st_size       = native.size::i64;
    st.st_blksize    = 4096;
    st.st_blocks     = ((native.size + 511) / 512)::i64;
    st.st_atime      = native.mtime::i64;
    st.st_atime_nsec = 0;
    st.st_mtime      = native.mtime::i64;
    st.st_mtime_nsec = 0;
    st.st_ctime      = native.mtime::i64;
    st.st_ctime_nsec = 0;
}

pub fun stat(fd: i32, st: *stat_t) i64 {
    var native: NativeStat;
    val r:      i64 = syscall2(SYS_FSTAT, fd::isize::usize, (?native)::usize);
    if (r < 0) { ret r; }
    fill_stat(?native, st);
    ret 0;
}

# MachOS has no symbolic links, so every lookup is already nofollow
pub fun stat_path(dirfd: i32, path: *u8, st: *stat_t, flags: i32) i64 {
    var full:   [256]u8;
    val n:      i64 = resolve(dirfd, path, ?full[0]);
    if (n < 0) { ret n; }
    var native: NativeStat;
    val r:      i64 = syscall3(SYS_STAT, (?full[0])::usize, n::usize, (?native)::usize);
    if (r < 0) { ret r; }
    fill_stat(?native, st);
    ret 0;
}

pub fun stat_mode(st: *stat_t) u32 {
    ret st.st_mode;
}

pub fun set_mode(fd: i32, mode: i32) i64 {
    var full: [256]u8;
    val n:    i64 = syscall3(SYS_FDPATH, fd::isize::usize, (?full[0])::usize, PATH_MAX);
    if (n < 0) { ret n; }
    if (n::usize >= PATH_MAX) { ret ENAMETOOLONG; }
    ret syscall3(SYS_CHMOD, (?full[0])::usize, n::usize, mode::u32::usize);
}

pub fun set_mode_at(dirfd: i32, name: *u8, mode: i32) i64 {
    if (name == nil) { ret EINVAL; }
    var full: [256]u8;
    val n:    i64 = resolve(dirfd, name, ?full[0]);
    if (n < 0) { ret n; }
    ret syscall3(SYS_CHMOD, (?full[0])::usize, n::usize, mode::u32::usize);
}

# open files keep their contents after an unlink, but MachOS has no handle
# that pins a file without reading it, so no publication capability is claimed
pub fun publication_capabilities(fd: i32) i64 {
    var st: stat_t;
    val r:  i64 = stat(fd, ?st);
    if (r < 0) { ret r; }
    ret 0;
}

pub fun file_identity(fd: i32, out: *identities.Identity) i64 {
    if (out == nil) { ret EINVAL; }
    var st: stat_t;
    val r:  i64 = stat(fd, ?st);
    if (r < 0) { ret r; }
    @out = identities.native(identities.MACHOS_LOCAL, st.st_dev, st.st_ino);
    ret 0;
}

pub fun retain_identity_at(dirfd: i32, path: *u8, access: identities.Access, out: *identities.Identity) i64 {
    if (dirfd == AT_FDCWD || path == nil || out == nil || access > identities.READ_AUTHORIZED) { ret EINVAL; }
    ret ENOTSUP;
}

pub fun identity_at(dirfd: i32, path: *u8, out: *identities.Identity) i64 {
    if (out == nil || path == nil) { ret EINVAL; }
    var st: stat_t;
    val r:  i64 = stat_path(dirfd, path, ?st, AT_SYMLINK_NOFOLLOW);
    if (r < 0) { ret r; }
    @out = identities.native(identities.MACHOS_LOCAL, st.st_dev, st.st_ino);
    ret 0;
}

# REMOVE takes a file or an empty directory; AT_REMOVEDIR says which one
pub fun unlink(dirfd: i32, path: *u8, flags: i32) i64 {
    var full: [256]u8;
    val n:    i64 = resolve(dirfd, path, ?full[0]);
    if (n < 0) { ret n; }
    var native: NativeStat;
    val r:      i64 = syscall3(SYS_STAT, (?full[0])::usize, n::usize, (?native)::usize);
    if (r < 0) { ret r; }
    if ((flags & AT_REMOVEDIR) != 0 && native.kind != KIND_DIR) { ret ENOTDIR; }
    if ((flags & AT_REMOVEDIR) == 0 && native.kind == KIND_DIR) { ret EISDIR; }
    ret syscall2(SYS_REMOVE, (?full[0])::usize, n::usize);
}

pub fun rename(olddir: i32, oldpath: *u8, newdir: i32, newpath: *u8) i64 {
    var from: [256]u8;
    var to:   [256]u8;
    val fl:   i64 = resolve(olddir, oldpath, ?from[0]);
    if (fl < 0) { ret fl; }
    val tl: i64 = resolve(newdir, newpath, ?to[0]);
    if (tl < 0) { ret tl; }
    ret syscall4(SYS_RENAME, (?from[0])::usize, fl::usize, (?to[0])::usize, tl::usize);
}

# one process at a time writes a file on MachOS for now: locks always succeed
pub fun lock_fd(fd: i32, op: i32) i64 {
    var st: stat_t;
    ret stat(fd, ?st);
}

pub fun symlink(target: *u8, linkpath: *u8) i64 {
    ret ENOTSUP;
}

pub fun make_dir(dirfd: i32, path: *u8, mode: i32) i64 {
    var full: [256]u8;
    val n:    i64 = resolve(dirfd, path, ?full[0]);
    if (n < 0) { ret n; }
    ret syscall3(SYS_MKDIR, (?full[0])::usize, n::usize, mode::u32::usize);
}

pub fun directory_init(out: *DirectoryCursor, fd: i32) DirectoryInitResult {
    if (out == nil || (out.address != 0 && (out.address != out::usize || out.active))) {
        ret DirectoryInitResult{code: EINVAL};
    }
    out.address = out::usize;
    out.active  = false;
    var st:      stat_t;
    val checked: i64 = stat(fd, ?st);
    if (checked < 0)                          { ret DirectoryInitResult{code: checked}; }
    if ((stat_mode(?st) & S_IFMT) != S_IFDIR) { ret DirectoryInitResult{code: ENOTDIR}; }
    out.fd     = fd;
    out.index  = 0;
    out.ended  = false;
    out.error  = 0;
    out.active = true;
    ret DirectoryInitResult{};
}

pub fun directory_next(cursor: *DirectoryCursor, out: *DirectoryEntry) i64 {
    if (cursor == nil || out == nil || cursor.address != cursor::usize || !cursor.active) { ret EINVAL; }
    if (cursor.error < 0)                                                                 { ret cursor.error; }
    if (cursor.ended)                                                                     { ret 0; }
    val got: i64 = syscall3(SYS_READDIR, cursor.fd::isize::usize, cursor.index, (?cursor.entry)::usize);
    if (got < 0) {
        cursor.error = got;
        ret got;
    }
    if (got == 0) {
        cursor.ended = true;
        ret 0;
    }
    cursor.index = cursor.index + 1;
    var n: usize = cursor.entry.name_len::usize;
    if (n > 59) { n = 59; }
    var i: usize = 0;
    for (i < n) {
        cursor.name[i] = cursor.entry.name[i];
        i              = i + 1;
    }
    cursor.name[n] = 0;
    var hint: u8 = 8; # DT_REG
    if (cursor.entry.kind == KIND_DIR) { hint = 4; }
    or (cursor.entry.kind == KIND_DEV) { hint = 2; }
    or (cursor.entry.kind == KIND_PIPE) { hint = 1; }
    @out = DirectoryEntry{name: (?cursor.name[0])::str, length: n, type_hint: hint};
    ret 1;
}

pub fun directory_close(cursor: *DirectoryCursor) i64 {
    if (cursor == nil || cursor.address != cursor::usize) { ret EINVAL; }
    cursor.active = false;
    ret 0;
}

# F_OK (0) asks only whether it is there
pub fun access(dirfd: i32, path: *u8, mode: i32, flags: i32) i64 {
    var full: [256]u8;
    val n:    i64 = resolve(dirfd, path, ?full[0]);
    if (n < 0) { ret n; }
    if (mode == 0) {
        var native: NativeStat;
        val r:      i64 = syscall3(SYS_STAT, (?full[0])::usize, n::usize, (?native)::usize);
        if (r < 0) { ret r; }
        ret 0;
    }
    ret syscall3(SYS_ACCESS, (?full[0])::usize, n::usize, mode::u32::usize);
}

pub fun seek(fd: i32, offset: i64, whence: i32) i64 {
    ret syscall3(SYS_SEEK, fd::isize::usize, offset::isize::usize, whence::u32::usize);
}

# environment (set by the runtime at program start)
pub var _envp: usize = 0;

pub fun environ() **u8 {
    ret _envp::**u8;
}

pub fun getenv(name: *u8, buf: *u8, cap: usize) i64 {
    if (_envp == 0) { ret ENOENT; }
    val envp:     **u8  = _envp::**u8;
    val name_len: usize = str_len(name);
    var i:        usize = 0;
    for (envp[i]::usize != 0) {
        val entry: *u8 = envp[i];
        if (str_starts_with(entry, name) && entry[name_len] == '='::u8) {
            val val_start: usize = name_len + 1;
            val len:       usize = str_len(?entry[val_start]);
            var j:         usize = 0;
            for (j < len && j + 1 < cap) {
                buf[j] = entry[val_start + j];
                j      = j + 1;
            }
            if (j < cap) { buf[j] = 0; }
            ret len::i64;
        }
        i = i + 1;
    }
    ret ENOENT;
}

pub fun getcwd(buf: *u8, size: usize) i64 {
    var here: [256]u8;
    val n:    i64 = syscall2(SYS_GETCWD, (?here[0])::usize, PATH_MAX);
    if (n < 0) { ret n; }
    if (n::usize + 1 > size) { ret ERANGE; }
    var i: usize = 0;
    for (i < n::usize) {
        buf[i] = here[i];
        i      = i + 1;
    }
    buf[n::usize] = 0;
    ret n;
}

# the runtime knows MachOS's page size and stack without asking
pub fun capture_pagesz() {}
pub fun capture_main_stack() {}
pub fun loader_present() bool { ret false; }

# process

pub fun terminate(code: i64) {
    syscall1(SYS_EXIT, code::usize);
    asm x86_64 { hlt }
}

pub fun abort() {
    terminate(255);
}

pub fun fork() i64 { ret syscall0(36); }
pub fun vfork() i64 { ret syscall0(36); }

pub fun exec(pathname: *u8, argv: **u8, envp: **u8) i64 {
    var args: [8192]u8;
    var env:  [16384]u8;
    val al:   i64 = pack(argv, ?args[0], 8192);
    if (al < 0) { ret al; }
    # the environment ends with an empty string
    val el: i64 = pack(envp, ?env[0], 16383);
    if (el < 0) { ret el; }
    env[el::usize] = 0;
    ret syscall5(37, pathname::usize, str_len(pathname), (?args[0])::usize, al::usize, (?env[0])::usize);
}

# the process shapes every OS layer shares
fwd ProcessStatus:        os_shared.ProcessStatus;
fwd FileLimit:            os_shared.FileLimit;
fwd LIMIT_UNLIMITED:      os_shared.LIMIT_UNLIMITED;
fwd ProcessWaitError:     os_shared.ProcessWaitError;
fwd WaitResult:           os_shared.WaitResult;
fwd PROCESS_OP_WAIT:      os_shared.PROCESS_OP_WAIT;
fwd PROCESS_OP_STATUS:    os_shared.PROCESS_OP_STATUS;
fwd PROCESS_OP_CLOSE:     os_shared.PROCESS_OP_CLOSE;
fwd PROCESS_OP_SPAWN:     os_shared.PROCESS_OP_SPAWN;
fwd PROCESS_OP_READ:      os_shared.PROCESS_OP_READ;
fwd PROCESS_OP_PIPE:      os_shared.PROCESS_OP_PIPE;
fwd PROCESS_OP_TERMINATE: os_shared.PROCESS_OP_TERMINATE;
fwd PROCESS_EXITED:       os_shared.PROCESS_EXITED;
fwd PROCESS_SIGNALED:     os_shared.PROCESS_SIGNALED;
fwd PROCESS_STOPPED:      os_shared.PROCESS_STOPPED;
fwd PROCESS_CONTINUED:    os_shared.PROCESS_CONTINUED;

fun decode_process_status(raw: i32) os_shared.ProcessStatus {
    ret os_shared.posix_status(raw, raw == 0xffff);
}

pub fun wait(pid: i64, status: *os_shared.ProcessStatus, options: i32, rusage: *u8) os_shared.WaitResult {
    var raw:     u64   = 0;
    var retries: usize = 0;
    for (retries < EINTR_MAX_RETRIES) {
        val res: i64 = syscall3(SYS_WAIT, pid::usize, (?raw)::usize, (options & WNOHANG)::u32::usize);
        if (res >= 0) {
            if (res > 0 && status != nil) { @status = decode_process_status(raw::i32); }
            ret os_shared.WaitResult{pid: res};
        }
        if (res != EINTR) { ret os_shared.WaitResult{error: os_shared.ProcessWaitError{code: res, operation: os_shared.PROCESS_OP_WAIT}}; }
        retries = retries + 1;
    }
    ret os_shared.WaitResult{error: os_shared.ProcessWaitError{code: EINTR, operation: os_shared.PROCESS_OP_WAIT}};
}

pub fun wait_pid(pid: i64, status: *os_shared.ProcessStatus, options: i32) os_shared.WaitResult {
    ret wait(pid, status, options, nil);
}

pub fun terminate_child(pid: i64) i64 {
    if (pid <= 0) { ret EINVAL; }
    ret syscall2(SYS_KILL, pid::usize, SIGKILL);
}

pub fun setpgid(pid: i64, pgid: i64) i64 {
    ret syscall2(43, pid::usize, pgid::usize);
}

pub fun getpgid(pid: i64) i64 {
    ret syscall1(44, pid::usize);
}

pub fun terminate_group(pgid: i64) i64 {
    if (pgid <= 0) { ret EINVAL; }
    ret syscall2(SYS_KILL, (0 - pgid)::usize, SIGKILL);
}

# a nil-ended array of strings as MachOS takes them: each one ending in NUL,
# one after the other
# ---
# ret: the bytes used, or a negative native code
fun pack(list: **u8, out: *u8, cap: usize) i64 {
    if (list == nil) { ret 0; }
    var at: usize = 0;
    var i:  usize = 0;
    for (list[i]::usize != 0) {
        val s: *u8   = list[i];
        val n: usize = str_len(s);
        if (at + n + 1 > cap) { ret E2BIG; }
        var k: usize = 0;
        for (k < n) {
            out[at + k] = s[k];
            k           = k + 1;
        }
        out[at + n] = 0;
        at          = at + n + 1;
        i           = i + 1;
    }
    ret at::i64;
}

# start pathname in a new process
# ---
# cwd:      its working directory, or nil for this one's
# redirect: whether stdin, stdout and stderr replace the inherited handles
# grouped:  whether it leads a new process group
# ret:      the child's pid, or a negative native code
fun spawn_with(pathname: *u8, argv: **u8, envp: **u8, cwd: *u8, redirect: bool, stdin_fd: i32, stdout_fd: i32, stderr_fd: i32, grouped: bool) i64 {
    if (pathname == nil) { ret EFAULT; }
    var args: [8192]u8;
    var env:  [16384]u8;
    var al:   i64 = pack(argv, ?args[0], 8192);
    if (al < 0) { ret al; }
    if (al == 0) { al = pack(?pathname, ?args[0], 8192); }
    var how: NativeSpawn;
    var i:   usize = 0;
    for (i < 10) {
        how.handles[i] = FD_NONE;
        i              = i + 1;
    }
    how.group   = 0;
    if (grouped) { how.group = 0xFFFFFFFFFFFFFFFF; }
    how.map_fds = 0;
    if (redirect) {
        how.map_fds    = 1;
        how.handles[0] = stdin_fd::isize::u64;
        how.handles[1] = stdout_fd::isize::u64;
        how.handles[2] = stderr_fd::isize::u64;
    }
    var source: **u8 = envp;
    if (source == nil) { source = environ(); }
    val el: i64 = pack(source, ?env[0], 16384);
    if (el < 0) { ret el; }
    how.env     = ?env[0];
    how.env_len = el::u64;
    # MachOS starts a child in its parent's working directory
    var saved: [256]u8;
    var sl:    i64 = 0;
    if (cwd != nil) {
        sl = syscall2(SYS_GETCWD, (?saved[0])::usize, PATH_MAX);
        if (sl < 0) { ret sl; }
        val moved: i64 = syscall2(SYS_CHDIR, cwd::usize, str_len(cwd));
        if (moved < 0) { ret moved; }
    }
    val pid: i64 = syscall5(SYS_SPAWN, pathname::usize, str_len(pathname), (?args[0])::usize, al::usize, (?how)::usize);
    if (cwd != nil) { syscall2(SYS_CHDIR, (?saved[0])::usize, sl::usize); }
    ret pid;
}

pub fun spawn(pathname: *u8, argv: **u8, envp: **u8) i64 {
    ret spawn_with(pathname, argv, envp, nil, false, 0, 1, 2, false);
}

pub fun spawn_grouped(pathname: *u8, argv: **u8, envp: **u8) i64 {
    ret spawn_with(pathname, argv, envp, nil, false, 0, 1, 2, true);
}

pub fun spawn_in(pathname: *u8, argv: **u8, envp: **u8, cwd: *u8) i64 {
    ret spawn_with(pathname, argv, envp, cwd, false, 0, 1, 2, false);
}

pub fun spawn_redirected(pathname: *u8, argv: **u8, envp: **u8, stdin_fd: i32, stdout_fd: i32, stderr_fd: i32) i64 {
    ret spawn_with(pathname, argv, envp, nil, true, stdin_fd, stdout_fd, stderr_fd, false);
}

pub fun spawn_redirected_grouped(pathname: *u8, argv: **u8, envp: **u8, stdin_fd: i32, stdout_fd: i32, stderr_fd: i32) i64 {
    ret spawn_with(pathname, argv, envp, nil, true, stdin_fd, stdout_fd, stderr_fd, true);
}

pub fun spawn_redirected_in(pathname: *u8, argv: **u8, envp: **u8, cwd: *u8, stdin_fd: i32, stdout_fd: i32, stderr_fd: i32) i64 {
    ret spawn_with(pathname, argv, envp, cwd, true, stdin_fd, stdout_fd, stderr_fd, false);
}

pub fun spawn_redirected_in_grouped(pathname: *u8, argv: **u8, envp: **u8, cwd: *u8, stdin_fd: i32, stdout_fd: i32, stderr_fd: i32) i64 {
    ret spawn_with(pathname, argv, envp, cwd, true, stdin_fd, stdout_fd, stderr_fd, true);
}

pub fun running_under_user_emulation() bool { ret false; }

pub fun getpid() i64 {
    ret syscall0(SYS_GETPID);
}

# MachOS gives every process 64 handles
val HANDLES: u64 = 64;

pub fun open_file_limit(out: *os_shared.FileLimit) i64 {
    out.soft    = HANDLES;
    out.hard    = HANDLES;
    out.ceiling = HANDLES;
    ret 0;
}

pub fun set_open_file_limit(limit: os_shared.FileLimit) i64 {
    if (limit.soft > HANDLES || limit.hard > HANDLES) { ret EPERM; }
    ret 0;
}

pub fun pipe(fds: *i32) i64 {
    var ends: [2]u64;
    val r:    i64 = syscall1(SYS_PIPE, (?ends[0])::usize);
    if (r < 0) { ret r; }
    fds[0] = ends[0]::i32;
    fds[1] = ends[1]::i32;
    ret 0;
}

pub fun ignore_sigpipe() i64 {
    val r: i64 = syscall4(SYS_SIGACTION, SIGPIPE, SIG_IGN, 0, 0);
    if (r < 0) { ret r; }
    ret 0;
}

# MachOS sleeps in milliseconds
pub fun sleep(nsec: i64) {
    if (nsec <= 0) { ret; }
    syscall1(SYS_SLEEP, ((nsec + 999999) / 1000000)::usize);
}

pub fun cpu_features(out: *cpu_features_.Features) i64 {
    cpu_features_.probe(out);
    ret 0;
}

pub fun cpu_dit() i64 {
    ret ENOTSUP;
}

# INFO's `cpus`, the sixth word of its record
pub fun cpu_count() i64 {
    var info: [64]u64;
    val r:    i64 = syscall1(SYS_INFO, (?info[0])::usize);
    if (r < 0 || info[5] == 0) { ret 1; }
    ret info[5]::i64;
}

pub fun thread_affinity(words: *u64, capacity: usize, out_count: *usize) i64 { ret ENOTSUP; }
pub fun set_thread_affinity(words: *u64, count: usize) i64 { ret ENOTSUP; }

# entropy

pub fun random_fill(buf: *u8, len: usize) i64 {
    var filled: usize = 0;
    for (filled < len) {
        var chunk: usize = len - filled;
        if (chunk > 0x100000) { chunk = 0x100000; }
        val res: i64 = syscall2(SYS_GETRANDOM, buf::usize + filled, chunk);
        if (res < 0) { ret res; }
        filled = filled + res::usize;
    }
    ret 0;
}

# time

pub fun clock_gettime(clock_id: i32, ts: *timespec) i64 {
    ret syscall2(SYS_CLOCK, clock_id::u32::usize, ts::usize);
}

# threads: not in the kernel yet

pub fun thread_spawn(
    f: fun(*u8), arg: *u8, state: *i64, reclaimable: *i64,
    owner: ptr, owner_size: usize, name: *u8,
    stack_reserve: usize, stack_commit: usize, native: *usize,
) i64 {
    ret ENOSYS;
}

pub fun thread_join(native: usize, reclaimable: *i64) i64 { ret ENOSYS; }
pub fun thread_detach(native: usize) i64 { ret ENOSYS; }
pub fun thread_current_id() i64 { ret getpid(); }

pub fun thread_current_name(name: *u8, cap: usize) i64 {
    if (cap < 1) { ret EINVAL; }
    name[0] = 0;
    ret 0;
}

pub fun thread_wait(addr: *i64, expected: i64) i64 { ret ENOSYS; }
pub fun thread_wait_until(addr: *i64, expected: i64, deadline: *os_shared.Timespec) i64 { ret ENOSYS; }
pub fun thread_wake(addr: *i64) i64 { ret ENOSYS; }

# no thread pointer yet: no block, and the token falls back to the thread id
pub fun thread_block() *os_shared.ThreadBlock { ret nil; }
pub fun thread_block_enter(block: *os_shared.ThreadBlock) i64 { ret ENOSYS; }

pub fun stack_bounds(low: *usize, high: *usize) bool { ret false; }

# io queue: not in the kernel yet

pub val IO_EVENT_READ:   u32 = 0x01;
pub val IO_EVENT_WRITE:  u32 = 0x02;
pub val IO_EVENT_ERROR:  u32 = 0x04;
pub val IO_EVENT_HANGUP: u32 = 0x08;
pub val IO_EVENT_WAKE:   u32 = 0x10;

pub rec IoCompletion {
    context: usize;
    events:  u32;
