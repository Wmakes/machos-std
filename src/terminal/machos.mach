# MachOS terminal backend (see ../terminal.mach)
#
# MachOS's TCGETATTR (28) and TCSETATTR (29) take a terminal handle and a
# record of the local mode flags plus the screen size. raw mode clears
# ICANON and ECHO; NOWAIT makes a read return at once when no key waits,
# which is what poll_key needs. raw-mode state is a single process-global
# toggle (_raw_active) and is not thread-safe.
#
# full-screen programs import this module directly for what the portable
# surface has not got: the screen size, and raw mode that waits for keys
# on any terminal handle (`size`, `raw`, `restore`).

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.isize;
use std.types.size.usize;

use io_error: std.io.error;
use terr:     std.terminal.error;
use std.terminal.key;
use std.system.os;
use sys: std.system.os.machos;

val SYS_TCGETATTR: usize = 28;
val SYS_TCSETATTR: usize = 29;

# MachOS's record: the local flags, and the screen (TCSETATTR ignores it)
rec Termios {
    lflag: u64;
    rows:  u64;
    cols:  u64;
}

val ISIG:   u64 = 1;
val ICANON: u64 = 2;
val ECHO:   u64 = 8;
val NOWAIT: u64 = 16;

var _saved:      Termios;
var _raw_active: bool = false;

fun tcgetattr(fd: i32, out: *Termios) i64 {
    ret sys.syscall2(SYS_TCGETATTR, fd::isize::usize, out::usize);
}

fun tcsetattr(fd: i32, t: *Termios) i64 {
    ret sys.syscall2(SYS_TCSETATTR, fd::isize::usize, t::usize);
}

# drop whatever's sitting unread in the input queue
# ---
# ret: ok, or the native refusal
pub fun flush_input() terr.Operation {
    var t: Termios;
    val got: i64 = tcgetattr(sys.STDIN_FD, ?t);
    if (got < 0) { ret terr.Operation.err{terr.TermError.native{os.error(got, io_error.OP_OPTION)}}; }
    var nowait: Termios = t;
    nowait.lflag = (t.lflag & ~ICANON) | NOWAIT;
    tcsetattr(sys.STDIN_FD, ?nowait);
    var b: u8 = 0;
    for (sys.read(sys.STDIN_FD, ?b, 1) > 0) {}
    tcsetattr(sys.STDIN_FD, ?t);
    ret terr.Operation.ok{};
}

# whether raw mode is currently active
pub fun is_raw() bool {
    ret _raw_active;
}

# switch stdin into raw mode: no line editing, no echo, and reads that
# return at once whether or not a key is waiting. disable_raw restores what
# was there; a second call without one is a no-op
# ---
# ret: ok, or the native refusal (ENOTTY when stdin is not a terminal)
pub fun enable_raw() terr.Operation {
    if (_raw_active) { ret terr.Operation.ok{}; }
    val got: i64 = tcgetattr(sys.STDIN_FD, ?_saved);
    if (got < 0) { ret terr.Operation.err{terr.TermError.native{os.error(got, io_error.OP_OPTION)}}; }
    var raw: Termios = _saved;
    raw.lflag = (raw.lflag & ~(ICANON | ECHO)) | NOWAIT;
    val set: i64 = tcsetattr(sys.STDIN_FD, ?raw);
    if (set < 0) { ret terr.Operation.err{terr.TermError.native{os.error(set, io_error.OP_OPTION)}}; }
    _raw_active = true;
    ret terr.Operation.ok{};
}

# restore what enable_raw saw; a no-op when raw mode is not active
# ---
# ret: ok, or the native refusal; raw mode stays active after a refusal
pub fun disable_raw() terr.Operation {
    if (!_raw_active) { ret terr.Operation.ok{}; }
    val r: i64 = tcsetattr(sys.STDIN_FD, ?_saved);
    if (r < 0) { ret terr.Operation.err{terr.TermError.native{os.error(r, io_error.OP_OPTION)}}; }
    _raw_active = false;
    ret terr.Operation.ok{};
}

# read one raw byte without blocking (needs enable_raw)
# ---
# ret: some{byte} if one was waiting, none when the queue was empty, or the
#      native read failure
pub fun poll_key() terr.Poll {
    var b: u8  = 0;
    val n: i64 = sys.read(sys.STDIN_FD, ?b, 1);
    if (n < 0)  { ret terr.Poll.err{terr.TermError.native{os.error(n, io_error.OP_READ)}}; }
    if (n == 0) { ret terr.Poll.ok{opt[key.Key].none{}}; }
    ret terr.Poll.ok{opt[key.Key].some{key.key_byte(b)}};
}

# MachOS only

# the screen of terminal handle h, in character rows and columns
# ---
# ret: 0, or a negative native code (ENOTTY when h is not a terminal)
pub fun size(h: usize, rows: *u64, cols: *u64) i64 {
    var t: Termios;
    val r: i64 = tcgetattr(h::isize::i32, ?t);
    if (r < 0) { ret r; }
    @rows = t.rows;
    @cols = t.cols;
    ret 0;
}

# raw mode on terminal handle h that waits for each key (^C still
# interrupts); `restore` puts back line editing and echo
# ---
# ret: 0, or a negative native code
pub fun raw(h: usize) i64 {
    var t: Termios;
    val r: i64 = tcgetattr(h::isize::i32, ?t);
    if (r < 0) { ret r; }
    t.lflag = 0;
    ret tcsetattr(h::isize::i32, ?t);
}

# line editing, echo and ^C, as a terminal starts out
pub fun restore(h: usize) i64 {
    var t: Termios;
    t.lflag = ISIG | ICANON | ECHO;
    t.rows = 0;
    t.cols = 0;
    ret tcsetattr(h::isize::i32, ?t);
}
